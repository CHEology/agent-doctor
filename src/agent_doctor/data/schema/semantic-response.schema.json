{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-doctor.local/schema/semantic-response.schema.json",
  "title": "Agent Doctor bounded semantic analyst response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_digest", "provider", "model", "role", "summary", "answers", "limitations"],
  "properties": {
    "schema_version": {"type": "string", "const": "agent-doctor-semantic-analyst-response/0.3"},
    "manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "provider": {"type": "string", "const": "codex-desktop"},
    "model": {"type": "string", "minLength": 1, "maxLength": 120},
    "role": {"type": "string", "enum": ["analyst_a", "analyst_b"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 1600},
    "limitations": {
      "type": "array", "maxItems": 20,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "answers": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "answer_id", "question_id", "source_refs", "claim_refs", "label",
          "dimension", "rationale", "citations", "shared_region",
          "distinct_contributions", "counterexample", "missing_evidence",
          "recommendation"
        ],
        "properties": {
          "answer_id": {"type": "string", "minLength": 1, "maxLength": 160},
          "question_id": {"type": "string", "minLength": 1, "maxLength": 160},
          "source_refs": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "pattern": "^source-[0-9a-f]{16,}$"}},
          "claim_refs": {"type": "array", "minItems": 1, "maxItems": 24, "items": {"type": "string", "pattern": "^claim-[0-9a-f]{16,}$"}},
          "label": {"type": "string", "enum": ["semantic_conflict", "scope_overlap", "behavioral_redundancy", "complementarity", "no_material_relation"]},
          "dimension": {"type": "string", "minLength": 1, "maxLength": 120},
          "rationale": {"type": "string", "minLength": 1, "maxLength": 1200},
          "citations": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "pattern": "^handle-[0-9a-f]{16,}$"}},
          "shared_region": {
            "type": "object", "additionalProperties": false,
            "required": ["status", "explanation"],
            "properties": {
              "status": {"type": "string", "enum": ["supported", "possible", "none", "unknown"]},
              "explanation": {"type": "string", "maxLength": 800}
            }
          },
          "distinct_contributions": {"type": "array", "maxItems": 8, "items": {"type": "string", "maxLength": 500}},
          "counterexample": {
            "type": "object", "additionalProperties": false,
            "required": ["status", "explanation"],
            "properties": {
              "status": {"type": "string", "enum": ["excluded", "open", "unknown"]},
              "explanation": {"type": "string", "maxLength": 800}
            }
          },
          "missing_evidence": {"type": "array", "maxItems": 12, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
          "recommendation": {
            "anyOf": [
              {"type": "null"},
              {
                "type": "object", "additionalProperties": false,
                "required": ["kind", "summary", "expected_benefit", "risk", "verification"],
                "properties": {
                  "kind": {"type": "string", "enum": ["clarify_trigger", "add_negative_trigger", "split_responsibility", "declare_primary_handler", "add_boundary_example", "add_eval_fixture", "no_action"]},
                  "summary": {"type": "string", "minLength": 1, "maxLength": 600},
                  "expected_benefit": {"type": "string", "minLength": 1, "maxLength": 600},
                  "risk": {"type": "string", "minLength": 1, "maxLength": 600},
                  "verification": {"type": "string", "minLength": 1, "maxLength": 600}
                }
              }
            ]
          }
        }
      }
    }
  }
}
