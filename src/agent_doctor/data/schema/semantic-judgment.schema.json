{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-doctor.local/schema/semantic-judgment.schema.json",
  "title": "Agent Doctor bounded semantic judge response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_digest", "provider", "model", "summary", "judgments", "limitations"],
  "properties": {
    "schema_version": {"type": "string", "const": "agent-doctor-semantic-judge-response/0.5"},
    "manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "provider": {"type": "string", "const": "codex-desktop"},
    "model": {"type": "string", "minLength": 1, "maxLength": 120},
    "summary": {"type": "string", "minLength": 1, "maxLength": 1600},
    "limitations": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "judgments": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "judgment_id", "question_id", "analyst_a_answer_id", "analyst_b_answer_id",
          "source_refs", "selected_label", "dimension", "disposition",
          "rationale", "citations", "counterexample", "missing_evidence",
          "recommendation_decision"
        ],
        "properties": {
          "judgment_id": {"type": "string", "minLength": 1, "maxLength": 160},
          "question_id": {"type": "string", "minLength": 1, "maxLength": 160},
          "analyst_a_answer_id": {"type": "string", "minLength": 1, "maxLength": 160},
          "analyst_b_answer_id": {"type": "string", "minLength": 1, "maxLength": 160},
          "source_refs": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "pattern": "^source-[0-9a-f]{16,}$"}},
          "selected_label": {
            "type": ["string", "null"],
            "enum": ["semantic_conflict", "scope_overlap", "behavioral_redundancy", "complementarity", "no_material_relation", null]
          },
          "dimension": {"type": "string", "minLength": 1, "maxLength": 120},
          "disposition": {"type": "string", "enum": ["corroborated_consensus", "resolved_disagreement", "challenged", "insufficient"]},
          "rationale": {"type": "string", "minLength": 1, "maxLength": 1200},
          "citations": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "pattern": "^handle-[0-9a-f]{16,}$"}},
          "counterexample": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "explanation"],
            "properties": {
              "status": {"type": "string", "enum": ["excluded", "open", "unknown"]},
              "explanation": {"type": "string", "maxLength": 800}
            }
          },
          "missing_evidence": {"type": "array", "maxItems": 12, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
          "recommendation_decision": {
            "anyOf": [
              {
                "type": "object", "additionalProperties": false,
                "required": ["selected_from", "disposition"],
                "properties": {
                  "selected_from": {"type": "string", "const": "none"},
                  "disposition": {"type": "string", "const": "not_applicable"}
                }
              },
              {
                "type": "object", "additionalProperties": false,
                "required": ["selected_from", "disposition"],
                "properties": {
                  "selected_from": {"type": "string", "const": "analyst_a"},
                  "disposition": {"type": "string", "enum": ["accepted", "challenged", "insufficient", "not_applicable"]}
                }
              },
              {
                "type": "object", "additionalProperties": false,
                "required": ["selected_from", "disposition"],
                "properties": {
                  "selected_from": {"type": "string", "const": "analyst_b"},
                  "disposition": {"type": "string", "enum": ["accepted", "challenged", "insufficient", "not_applicable"]}
                }
              }
            ]
          }
        }
      }
    }
  }
}
