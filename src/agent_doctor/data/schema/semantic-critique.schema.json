{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-doctor.local/schema/semantic-critique.schema.json",
  "title": "Agent Doctor bounded semantic critic response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_digest", "provider", "model", "summary", "reviews", "limitations"],
  "properties": {
    "schema_version": {"const": "agent-doctor-semantic-critic-response/0.2"},
    "manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "provider": {"const": "codex-desktop"},
    "model": {"type": "string", "minLength": 1, "maxLength": 120},
    "summary": {"type": "string", "minLength": 1, "maxLength": 1600},
    "limitations": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "reviews": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "review_id", "question_id", "answer_id", "source_refs", "claim_refs",
          "label", "dimension", "disposition", "rationale", "citations",
          "counterexample", "missing_evidence", "recommendation_disposition"
        ],
        "properties": {
          "review_id": {"type": "string", "minLength": 1, "maxLength": 160},
          "question_id": {"type": "string", "minLength": 1, "maxLength": 160},
          "answer_id": {"type": "string", "minLength": 1, "maxLength": 160},
          "source_refs": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^source-[0-9a-f]{16,}$"}},
          "claim_refs": {"type": "array", "minItems": 1, "maxItems": 24, "uniqueItems": true, "items": {"type": "string", "pattern": "^claim-[0-9a-f]{16,}$"}},
          "label": {"enum": ["semantic_conflict", "scope_overlap", "behavioral_redundancy", "complementarity", "no_material_relation"]},
          "dimension": {"type": "string", "minLength": 1, "maxLength": 120},
          "disposition": {"enum": ["corroborated", "challenged", "insufficient"]},
          "rationale": {"type": "string", "minLength": 1, "maxLength": 1200},
          "citations": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^handle-[0-9a-f]{16,}$"}},
          "counterexample": {
            "type": "object", "additionalProperties": false,
            "required": ["status", "explanation"],
            "properties": {
              "status": {"enum": ["excluded", "open", "unknown"]},
              "explanation": {"type": "string", "maxLength": 800}
            }
          },
          "missing_evidence": {"type": "array", "maxItems": 12, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
          "recommendation_disposition": {"enum": ["accepted", "challenged", "insufficient", "not_applicable"]}
        }
      }
    }
  }
}
